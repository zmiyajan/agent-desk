#!/bin/sh
# The one browser on this desk. A person at the screen and an agent over CDP use the same window and the same
# profile, so a login done by hand is there for the agent afterwards.
# --no-sandbox: Chromium's own sandbox needs kernel features containers do not get by default; the container
# is the isolation boundary here.
exec chromium \
  --user-data-dir="$HOME/.browser" \
  --remote-debugging-port=9222 \
  --no-first-run --no-default-browser-check --test-type \
  --hide-crash-restore-bubble --disable-session-crashed-bubble \
  --no-sandbox --disable-dev-shm-usage --start-maximized \
  "$@"
