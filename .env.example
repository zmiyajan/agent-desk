# Required. The page gives a shell on the agent's computer, so the stack refuses to start without it.
# At least 12 characters.
DESK_PASSWORD=

# Shown on the sign-in page and in the browser tab
DESK_NAME=Agent Desk

# Where the page listens. Keep loopback unless TLS or a private network is in front (docs/EXPOSE.md).
DESK_BIND=127.0.0.1
DESK_PORT=8080

# The agent's screen. 16:9 recommended.
DESK_GEOMETRY=1600x900

# Open Chromium when the desk starts, so an agent can attach to it right away (1 or 0)
DESK_BROWSER_AUTOSTART=1

# Memory limit of the desktop container
DESK_MEMORY=2g

# Signing key for the session cookie. Empty = a new key, and everyone signed out, on every restart.
DESK_SECRET=

TZ=UTC
